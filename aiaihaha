--[[
	📍 ĐỊNH VỊ NGƯỜI CHƠI (Player Locator)
	📁 Cách đặt: Roblox Studio → StarterPlayer → StarterPlayerScripts
	   → chuột phải → Insert Object → LocalScript → dán code này vào

	✨ Tính năng:
	• Nhấn phím E hoặc bấm nút trên màn hình để BẬT/TẮT định vị
	• Người chơi thường      → 🟢 Xanh lá
	• Người chơi bị hạ gục   → 🔴 Đỏ
	• Bạn bè                 → 🌸 Hồng
	• Bạn bè bị hạ gục       → 🟣 Tím
	• Trên đầu mỗi người hiện: tên + trạng thái + thời gian bị hạ
	• Nhìn xuyên tường, biết ngay đồng đội ở đâu!
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer

-- ⚙️ ===== TÙY CHỈNH (đổi theo ý bạn) =====
local TOGGLE_KEY = Enum.KeyCode.E -- phím bật/tắt định vị
local UPDATE_INTERVAL = 0.25 -- giây giữa mỗi lần cập nhật

local COLOR_ALIVE = Color3.fromRGB(60, 255, 60) -- 🟢 người chơi thường
local COLOR_DOWNED = Color3.fromRGB(255, 60, 60) -- 🔴 người chơi bị hạ
local COLOR_FRIEND = Color3.fromRGB(255, 120, 200) -- 🌸 bạn bè
local COLOR_FRIEND_DOWNED = Color3.fromRGB(180, 70, 255) -- 🟣 bạn bè bị hạ
-- ============================================

local enabled = false
local tracked = {} -- [player] = {highlight, billboard, nameLabel, statusLabel}
local downedTimes = {} -- [player] = thời điểm bị hạ
local friendCache = {} -- [player] = true/false (lưu cache để không lag)

-- Đổi giây → dạng "phút:giây" (vd: 75 giây → "1:15")
local function formatTime(seconds)
	local minutes = math.floor(seconds / 60)
	local secs = math.floor(seconds % 60)
	return string.format("%d:%02d", minutes, secs)
end

-- Kiểm tra có phải bạn bè không
local function isFriend(player)
	if friendCache[player] ~= nil then
		return friendCache[player]
	end
	local ok, result = pcall(function()
		return localPlayer:IsFriendsWith(player.UserId)
	end)
	friendCache[player] = (ok and result) or false
	return friendCache[player]
end

-- Xóa hiệu ứng của 1 người chơi
local function clearVisuals(player)
	local data = tracked[player]
	if data then
		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
		tracked[player] = nil
	end
end

-- Xóa hiệu ứng của tất cả mọi người
local function clearAll()
	for player in pairs(tracked) do
		clearVisuals(player)
	end
end

-- Tạo highlight + bảng tên cho 1 người chơi
local function createVisuals(player)
	clearVisuals(player)

	local character = player.Character
	if not character then return end
	local head = character:FindFirstChild("Head")
	if not head then return end

	-- Viền sáng bao quanh nhân vật (nhìn xuyên tường)
	local highlight = Instance.new("Highlight")
	highlight.Name = "LocatorHighlight"
	highlight.Adornee = character
	highlight.FillTransparency = 0.6
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	-- Bảng chữ trên đầu
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "LocatorBillboard"
	billboard.Size = UDim2.fromOffset(220, 55)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 15
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.Text = player.DisplayName
	nameLabel.Parent = billboard

	local statusLabel = Instance.new("TextLabel")
	statusLabel.Size = UDim2.new(1, 0, 0.5, 0)
	statusLabel.Position = UDim2.new(0, 0, 0.5, 0)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Font = Enum.Font.Gotham
	statusLabel.TextSize = 13
	statusLabel.TextStrokeTransparency = 0.5
	statusLabel.Parent = billboard

	tracked[player] = {
		highlight = highlight,
		billboard = billboard,
		nameLabel = nameLabel,
		statusLabel = statusLabel,
	}
end

-- Cập nhật màu sắc + chữ cho 1 người chơi
local function updatePlayer(player)
	if player == localPlayer then return end

	-- Tính năng đang tắt → không hiện gì cả
	if not enabled then
		clearVisuals(player)
		return
	end

	local character = player.Character
	if not character or not character.Parent then
		clearVisuals(player)
		return
	end

	-- Kiểm tra bị hạ gục: hết máu hoặc mất Humanoid
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local downed = (humanoid == nil) or humanoid.Health <= 0

	-- Ghi lại thời điểm bắt đầu bị hạ
	if downed then
		if not downedTimes[player] then
			downedTimes[player] = os.clock()
		end
	else
		downedTimes[player] = nil
	end

	-- Chọn màu theo trạng thái
	local friend = isFriend(player)
	local color
	if friend and downed then
		color = COLOR_FRIEND_DOWNED -- 🟣 bạn bè bị hạ
	elseif friend then
		color = COLOR_FRIEND -- 🌸 bạn bè
	elseif downed then
		color = COLOR_DOWNED -- 🔴 bị hạ
	else
		color = COLOR_ALIVE -- 🟢 bình thường
	end

	-- Tạo hiệu ứng nếu chưa có (hoặc đã mất do hồi sinh)
	local data = tracked[player]
	if not data or not data.billboard or data.billboard.Parent == nil then
		createVisuals(player)
		data = tracked[player]
	end
	if not data then return end

	-- Cập nhật màu cho viền sáng và chữ
	data.highlight.FillColor = color
	data.highlight.OutlineColor = color
	data.nameLabel.TextColor3 = color
	data.statusLabel.TextColor3 = color

	-- Cập nhật dòng trạng thái
	if downed then
		local seconds = os.clock() - (downedTimes[player] or os.clock())
		data.statusLabel.Text = "💀 Bị hạ • " .. formatTime(seconds)
	elseif friend then
		data.statusLabel.Text = "💗 Bạn bè"
	else
		data.statusLabel.Text = "✅ Đang sống"
	end
end

-- ===== 🔘 NÚT BẬT/TẮT TRÊN MÀN HÌNH (cho điện thoại) =====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LocatorGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(150, 42)
button.Position = UDim2.new(1, -160, 0, 10)
button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.GothamBold
button.TextSize = 14
button.Text = "📍 Định vị: TẮT"
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = button

-- ===== 🔀 HÀM BẬT/TẮT =====
local function setEnabled(value)
	enabled = value
	if enabled then
		button.Text = "📍 Định vị: BẬT"
		button.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
	else
		button.Text = "📍 Định vị: TẮT"
		button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		clearAll()
	end
end

button.MouseButton1Click:Connect(function()
	setEnabled(not enabled)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end -- đang gõ chat thì bỏ qua
	if input.KeyCode == TOGGLE_KEY then
		setEnabled(not enabled)
	end
end)

-- ===== 🧹 DỌN DẸP TỰ ĐỘNG =====
-- Khi người chơi rời game
Players.PlayerRemoving:Connect(function(player)
	clearVisuals(player)
	downedTimes[player] = nil
	friendCache[player] = nil
end)

-- Khi người chơi hồi sinh: reset hiệu ứng + thời gian bị hạ
local function watchPlayer(player)
	player.CharacterAdded:Connect(function()
		clearVisuals(player)
		downedTimes[player] = nil
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	watchPlayer(player)
end
Players.PlayerAdded:Connect(watchPlayer)

-- ===== 🔄 VÒNG LẶP CẬP NHẬT CHÍNH =====
task.spawn(function()
	while true do
		for _, player in ipairs(Players:GetPlayers()) do
			updatePlayer(player)
		end
		task.wait(UPDATE_INTERVAL)
	end
end)

print("📍 Player Locator đã sẵn sàng! Nhấn phím E để bật/tắt.")
